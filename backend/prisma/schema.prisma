generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salon {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique // e.g. "studio-vip" for /agendar/studio-vip
  email         String         @unique
  password      String         // hashed password
  plan          String         @default("start") // "start", "pro", "elite"
  createdAt     DateTime       @default(now())
  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]
}

model Professional {
  id           String        @id @default(uuid())
  name         String
  role         String
  color        String        @default("bg-blue-500")
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  services     Service[]
}

model Service {
  id               String        @id @default(uuid())
  name             String
  price            Float
  durationMins     Int
  returnsInDays    Int?          
  salonId          String
  salon            Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  professionalId   String
  professional     Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  createdAt        DateTime      @default(now())
}

model Client {
  id             String        @id @default(uuid())
  name           String
  phone          String        
  noShowCount    Int           @default(0) 
  salonId        String
  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  createdAt      DateTime      @default(now())

  @@unique([phone, salonId])
}

model Appointment {
  id             String        @id @default(uuid())
  date           String        // Date of the appointment (YYYY-MM-DD)
  startTime      String        // e.g "14:30"
  status         String        @default("pending") // pending, confirmed, completed, no-show
  salonId        String
  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
